{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gre-roots",
  "compatibility_date": "2026-08-31",
  "main": "./sites-worker/index.js",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/data/vocabulary.json"
    ]
  }
}
